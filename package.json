{
  "name": "invoice-ninja-mcp-server",
  "version": "0.5.0",
  "description": "MCP server for Invoice Ninja - create invoices, manage clients, payments, quotes, and expenses",
  "type": "module",
  "main": "dist/index.js",
  "bin": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/index.js",
    "prepare": "npm run build",
    "watch": "tsc --watch"
  },
  "keywords": [
    "mcp",
    "invoice-ninja",
    "invoicing",
    "claude",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "shx": "^0.4.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.13.16",
      "@hono/node-server": "2.1.6",
      "fast-uri": "3.1.9",
      "ip-address": "10.7.6",
      "qs": "6.17.1",
      "path-to-regexp": "8.4.2",
      "body-parser": "2.4.0",
      "express-rate-limit": "8.7.3",
      "proxy-addr": "2.0.8"
    }
  }
}
